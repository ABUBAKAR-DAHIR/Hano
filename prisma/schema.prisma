// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum ProductStatus {
  ACTIVE
  DRAFT
  OUT_OF_STOCK
  DISCONTINUED
}

model Product {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String        @db.Text

  // Pricing
  price         Decimal  @db.Decimal(12, 2)
  currency      String   @default("USD")
  compareAtPrice Decimal? @db.Decimal(12, 2)

  // Product information
  manufacturer String
  model         String
  algorithm     String?
  hashRate      String?
  power         Int?       // Watts
  cooling       String?    // Air cooled, liquid cooled
  noiseLevel    Int?       // dB

  // Inventory
  stock    Int           @default(0)
  status   ProductStatus @default(ACTIVE)
  isNew    Boolean       @default(false)
  featured Boolean       @default(false)

  // Relationships
  images     ProductImage[]
  categories Category[]
  tags       Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([manufacturer])
  @@index([price])
}

model ProductImage {
  id        String  @id @default(uuid())
  url       String
  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

model Tag {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  products Product[]
}

enum SubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
}

model EmailSubscription {
  id             String             @id @default(uuid())
  email          String             @unique
  status         SubscriptionStatus @default(ACTIVE)
  subscribedAt   DateTime           @default(now())
  unsubscribedAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([status])
  @@map("email_subscriptions")
}

// Message
enum InquiryTopic {
  BUYING_A_RIG
  HOSTING
  SUPPORT
  PARTNERSHIP
  OTHER
}

enum MinerQuantity {
  ONE_TO_FIVE
  SIX_TO_TWENTY
  TWENTY_ONE_TO_ONE_HUNDRED
  OVER_ONE_HUNDRED
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

